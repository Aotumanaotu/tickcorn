# Copy to .env (same directory as docker-compose.yml) and edit before deploy.
# NEVER commit the real .env file.

# PostgreSQL password for the TimescaleDB container.
MICROTERM_DB_PASSWORD=change-me-before-deploy

# Bootstrap admin account, created on first api startup only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too

# ---- public HTTPS access (caddy) ----
# Domain whose DNS A record points at this server. Let's Encrypt certs are
# issued and renewed automatically; security group must allow 80 + 443.
DOMAIN=market.example.com
ACME_EMAIL=you@example.com

# production = Secure cookies (HTTPS). Only switch to "dev" when accessing
# via SSH tunnel over plain http.
APP_ENV=production
