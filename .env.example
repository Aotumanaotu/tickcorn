# Copy to .env (same directory as docker-compose.yml) and edit before deploy.
# NEVER commit the real .env file.

# PostgreSQL password for the TimescaleDB container.
MICROTERM_DB_PASSWORD=change-me-before-deploy

# Bootstrap admin account, created on first api startup only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too

# "dev" serves refresh cookies without the Secure flag (plain http over the
# SSH tunnel). Switch to "production" when terminating TLS in front of api.
APP_ENV=dev
