# environments / build
.venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.agents/
.codex/

# Original SDK archives (runtime headers and libraries live in third_party/)
*.zip

# Proprietary SDK is supplied locally under its own terms; build artifacts are local.
third_party/ctp/
src/app/gateway/native/*.so

# data (research artifacts, never commit)
data/
!data/.gitkeep

# local secrets / notes
.env
.env.*
!.env.example
*.local.yaml
settings.local.json
nohup.out

# Deployment overrides and private key material
compose.override.yaml
compose.override.yml
docker-compose.override.yml
deploy/*.local.*
*.pem
*.key
*.local.json

# Generated demo reports are runtime artifacts, not source.
samples/synthetic_demo/*
!samples/synthetic_demo/README.txt

# Local browser verification artifacts
.playwright-cli/
output/

# Monitor (Node) local installs and logs
ops/monitor/node_modules/
ops/monitor/*.log
