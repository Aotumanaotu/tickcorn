# ---- 飞书自建应用机器人（官方 SDK）----
# 优先使用网页面板“每日简报”里填写的配置；本文件用于无面板/纯 headless 部署。
# 在飞书开放平台创建"企业自建应用"，开启机器人能力，获取以下凭证。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 接收方：群聊用 chat_id（推荐，把机器人拉进群）；也可用用户 open_id / email。
FEISHU_RECEIVE_ID=
# chat_id | open_id | user_id | union_id | email
FEISHU_RECEIVE_ID_TYPE=chat_id
# feishu(国内) | lark(国际)
FEISHU_DOMAIN=feishu

# ---- 定时发送（服务器/容器本地时间，默认东八区）----
REPORT_TIMES=08:00,12:30,21:30
TZ=Asia/Shanghai
# 仅异常时发送（true 则正常状态不打扰）
ALERT_ONLY=false
# 容器启动时先发一条
SEND_ON_START=false

# ---- 被监控服务 ----
# 同 compose 网络内用服务名；独立运行时改成 http://127.0.0.1:8800
DASHBOARD_URL=http://corn-tick:8800
DATA_DIR=/data
DASHBOARD_TOKEN_FILE=/data/dashboard-token.local.json
# 也可直接写令牌（优先级高于文件）
DASHBOARD_TOKEN=
# 只看这些合约，留空=全部
INSTRUMENTS=
HTTP_TIMEOUT_MS=8000
DISK_WARN_PERCENT=85

# ---- 展示 ----
REPORT_TITLE=玉米快照采集
SERVICE_NAME=corn-tick
# true 时不真正发送，只在日志打印消息（用于调试）
DRY_RUN=false
